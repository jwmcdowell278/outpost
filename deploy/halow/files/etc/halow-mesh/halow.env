# HaLow mesh + batman-adv settings, read by /usr/local/sbin/halow-mesh.
# Every node in the mesh needs the same COUNTRY, CHANNEL, OP_CLASS, MESH_ID
# and MESH_PASSWORD. Restart after editing:  sudo systemctl restart halow-mesh

# Regulatory country - must match where the radio is used (sets the legal
# HaLow frequencies and power). Also set in /etc/modprobe.d/morse.conf.
COUNTRY=US

# HaLow channel + operating class (they must agree). US options:
#   1 MHz: odd channels 1-51,          OP_CLASS=68
#   2 MHz: 2,6,10,...,50,              OP_CLASS=69
#   4 MHz: 8,16,24,32,40,48,           OP_CLASS=70
#   8 MHz: 12,28,44,                   OP_CLASS=71
# Wider = faster but shorter range. 4 MHz is a good fit for voice.
CHANNEL=40
OP_CLASS=70

# 802.11s mesh name and password (SAE/WPA3). Change the password!
MESH_ID=outpost-mesh
MESH_PASSWORD=change-this-mesh-password

# batman-adv routing algorithm: BATMAN_IV (mature, default) or BATMAN_V
# (uses link throughput; some HaLow users have reported kernel crashes with it).
BATMAN_ALGO=BATMAN_IV

# Address on bat0. Leave empty to derive a unique one from the radio's MAC:
# 10.42.<x>.<y>/16 - so the same settings file works on every node.
BAT_ADDRESS=
BAT_PREFIX=10.42
