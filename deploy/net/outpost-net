#!/bin/bash
# Forwarding between interfaces, and gateways that share one interface's
# internet with others through NAT. Uses its own nftables table
# (outpost_net), so other firewall rules are left as they are.
#
#   sudo outpost-net                         menu (also opens the Wi-Fi and mesh menus)
#   outpost-net status                       what's set up, and the mesh gateway in use
#   sudo outpost-net overview                everything at a glance: cards, mesh, internet
#   sudo outpost-net halow                   HaLow settings: channel, width, country, password
#   sudo outpost-net gateway UPLINK IFACE... share UPLINK's internet with these (NAT)
#   sudo outpost-net gateway-off UPLINK
#   sudo outpost-net forward IFACE1 IFACE2   route between two interfaces, both ways (no NAT)
#   sudo outpost-net unforward IFACE1 IFACE2
#   sudo outpost-net mesh-internet auto|off  use the mesh's gateway for internet
#   sudo outpost-net apply                   (re)load everything (run at boot)
#
# Settings: /etc/outpost-net/net.env
set -eu

ETC=${OUTPOST_NET_ETC:-/etc/outpost-net}    # override only for testing
CONF=$ETC/net.env
SYSCTL=/etc/sysctl.d/90-outpost-net.conf
TAG=outpost-net          # marks our Docker/ufw rules
TABLE=outpost_net        # our nftables table
SELF=$(readlink -f "$0")
PATH=$PATH:/usr/sbin:/sbin

GATEWAYS=; FORWARD=; MESH_INTERNET=off; MESH_GATEWAY=; MESH_DNS="1.1.1.1 9.9.9.9"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

say() { echo "$*" >&2; }
die() { echo "outpost-net: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "run with sudo"; }
in_list() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
valid_if() { echo "$1" | grep -Eq '^[A-Za-z0-9._-]{1,15}$' || die "bad interface name: $1"; }

save() {
    mkdir -p "$ETC"
    cat > "$CONF" <<EOF
# outpost-net settings - change with: sudo outpost-net
# Gateways: UPLINK:IFACE,IFACE... - share UPLINK's internet (NAT) with those.
GATEWAYS="$GATEWAYS"
# Forwarding without NAT, both ways: IFACE1:IFACE2 ...
FORWARD="$FORWARD"
# auto: route internet through the best gateway in the mesh; off: don't.
MESH_INTERNET=$MESH_INTERNET
# Fixed mesh gateway address instead of finding one (optional).
MESH_GATEWAY=$MESH_GATEWAY
# DNS servers to use while MESH_INTERNET=auto (set in NetworkManager, so
# names still resolve with no other network connected). Empty: leave DNS alone.
MESH_DNS="$MESH_DNS"
EOF
}

# --------------------------------------------------------------- the rules

# Pairs (from>to) that may start connections; replies are always allowed.
allowed_pairs() {
    local f g s up
    for g in $GATEWAYS; do
        up=${g%%:*}
        for s in $(echo "${g#*:}" | tr ',' ' '); do echo "$s>$up"; done
    done
    for f in $FORWARD; do echo "${f%%:*}>${f#*:}"; echo "${f#*:}>${f%%:*}"; done
}

managed_ifaces() {
    local f g
    { for g in $GATEWAYS; do echo "${g%%:*}"; echo "${g#*:}" | tr ',' '\n'; done
      for f in $FORWARD; do echo "${f%%:*}"; echo "${f#*:}"; done; } | sort -u | tr '\n' ' '
}

nft_rules() {
    local g i m p set_
    echo "table inet $TABLE"
    echo "delete table inet $TABLE"
    echo "table inet $TABLE {"
    echo "  chain forward {"
    echo "    type filter hook forward priority -10; policy accept;"
    # The mesh's MTU is smaller than most links: keep TCP segments fitting.
    echo "    tcp flags syn tcp option maxseg size set rt mtu"
    echo "    ct state established,related accept"
    for p in $(allowed_pairs); do
        echo "    iifname \"${p%%>*}\" oifname \"${p#*>}\" accept"
    done
    # Between interfaces set up here, only what's allowed above. Other
    # traffic (Docker, VPNs set up elsewhere...) is left to its own rules.
    m=$(managed_ifaces)
    if [ -n "$m" ]; then
        set_=$(for i in $m; do printf '"%s", ' "$i"; done | sed 's/, $//')
        echo "    iifname { $set_ } oifname { $set_ } drop"
    fi
    echo "  }"
    echo "  chain postrouting {"
    echo "    type nat hook postrouting priority 100; policy accept;"
    for g in $GATEWAYS; do
        echo "    oifname \"${g%%:*}\" masquerade"
    done
    echo "  }"
    echo "}"
}

# Docker sets the forward policy to DROP; its DOCKER-USER chain is where
# other forwarding has to be allowed. ufw needs "route allow" rules.
other_firewalls() {
    local old p rule
    if command -v iptables >/dev/null && iptables -n -L DOCKER-USER >/dev/null 2>&1; then
        while iptables -S DOCKER-USER | grep -q -- "--comment $TAG"; do
            rule=$(iptables -S DOCKER-USER | grep -- "--comment $TAG" | head -1 | sed 's/^-A /-D /')
            # shellcheck disable=SC2086
            eval "iptables $rule"
        done
        if [ -n "$(allowed_pairs)" ]; then
            for p in $(allowed_pairs); do
                iptables -I DOCKER-USER -i "${p%%>*}" -o "${p#*>}" -m comment --comment "$TAG" -j ACCEPT
            done
            iptables -I DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "$TAG" -j ACCEPT
        fi
    fi
    if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
        old=$ETC/ufw-applied
        [ -f "$old" ] && while read -r p; do
            ufw route delete allow in on "${p%%>*}" out on "${p#*>}" >/dev/null 2>&1 || true
        done < "$old"
        allowed_pairs > "$old"
        for p in $(allowed_pairs); do
            ufw route allow in on "${p%%>*}" out on "${p#*>}" comment "$TAG" >/dev/null
        done
    fi
    if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
        firewalld_apply
    fi
}

# firewalld (Fedora, RHEL-likes, openSUSE) filters forwarded traffic per
# zone and blocks it by default. Allow each pair with a policy
# (outpost-net-N) from the first interface's zone to the second's (a policy
# may have the same zone on both sides). Policies only cover interfaces
# placed in a zone, so an interface in none is placed in the default zone -
# whose rules it already uses, so what may reach the machine (e.g. SSH)
# doesn't change. Those placements are undone when no longer needed.
# Our nftables table still allows only the chosen interface pairs.
fw_zone() {
    local z
    z=$(firewall-cmd --get-zone-of-interface="$1" 2>/dev/null) || z=$(firewall-cmd --get-default-zone)
    echo "$z"
}

firewalld_apply() {
    local bound dz i n p pol seen want z za zb
    bound=$ETC/firewalld-placed
    dz=$(firewall-cmd --get-default-zone)
    for pol in $(firewall-cmd --permanent --get-policies 2>/dev/null); do
        case "$pol" in outpost-net-*) firewall-cmd --permanent --delete-policy="$pol" >/dev/null ;; esac
    done
    want=$(for p in $(allowed_pairs); do echo "${p%%>*}"; echo "${p#*>}"; done | sort -u | tr '\n' ' ')
    # Undo placements no longer needed, then place what's in no zone.
    if [ -f "$bound" ]; then
        while read -r i z; do
            in_list "$i" "$want" || firewall-cmd --permanent --zone="$z" --remove-interface="$i" >/dev/null 2>&1 || true
        done < "$bound"
    fi
    : > "$bound.new"
    if [ -f "$bound" ]; then
        while read -r i z; do in_list "$i" "$want" && echo "$i $z" >> "$bound.new"; done < "$bound"
    fi
    for i in $want; do
        grep -q "^$i " "$bound.new" && continue
        if ! firewall-cmd --get-zone-of-interface="$i" >/dev/null 2>&1 \
                && ! firewall-cmd --permanent --get-zone-of-interface="$i" >/dev/null 2>&1; then
            firewall-cmd --permanent --zone="$dz" --add-interface="$i" >/dev/null 2>&1 && echo "$i $dz" >> "$bound.new"
        fi
    done
    mkdir -p "$ETC"; mv "$bound.new" "$bound"; [ -s "$bound" ] || rm -f "$bound"
    n=0; seen=
    for p in $(allowed_pairs); do
        za=$(fw_zone "${p%%>*}"); zb=$(fw_zone "${p#*>}")
        in_list "$za>$zb" "$seen" && continue
        seen="$seen $za>$zb"
        n=$((n + 1)); pol="outpost-net-$n"
        firewall-cmd --permanent --new-policy="$pol" >/dev/null &&
        firewall-cmd --permanent --policy="$pol" --add-ingress-zone="$za" >/dev/null &&
        firewall-cmd --permanent --policy="$pol" --add-egress-zone="$zb" >/dev/null &&
        firewall-cmd --permanent --policy="$pol" --set-target=ACCEPT >/dev/null ||
            say "note: couldn't add firewalld policy $za -> $zb (needs firewalld 0.9 or newer)"
    done
    firewall-cmd --reload >/dev/null || say "note: firewalld didn't reload - see: firewall-cmd --state"
    [ -z "$seen" ] || say "   firewalld: forwarding allowed for zones:$(echo "$seen" | sed 's/>/ -> /g')"
}

mesh_prefix() {
    local f
    for f in /etc/outpost-mesh/mesh.env /etc/halow-mesh/halow.env; do
        [ -f "$f" ] && { sed -n 's/^BAT_PREFIX=//p' "$f" | head -1 | tr -d "'\""; return; }
    done
    echo 10.42
}

# batman-adv's gateway feature: a node that shares internet with the mesh
# announces it (server); nodes that want internet from the mesh pick the
# best one (client).
batman_gw_mode() {
    local g mode
    [ -e /sys/class/net/bat0 ] || return 0
    mode=off
    [ "$MESH_INTERNET" = auto ] && mode=client
    for g in $GATEWAYS; do in_list bat0 "$(echo "${g#*:}" | tr ',' ' ')" && mode=server; done
    [ "$(batctl gw_mode 2>/dev/null | cut -d' ' -f1)" = "$mode" ] || batctl gw_mode "$mode" >/dev/null 2>&1 || true
}

cmd_apply() {
    local before
    need_root
    command -v nft >/dev/null || die "needs nftables (nft)"
    if [ -n "$GATEWAYS$FORWARD" ]; then
        mkdir -p "$ETC"
        [ -f "$SYSCTL" ] || cat /proc/sys/net/ipv4/ip_forward > "$ETC/ip_forward.before"
        mkdir -p "$(dirname "$SYSCTL")"
        echo "net.ipv4.ip_forward = 1" > "$SYSCTL"
        sysctl -q -w net.ipv4.ip_forward=1
    elif [ -f "$SYSCTL" ]; then
        # Put IP forwarding back as it was before this tool turned it on -
        # but leave it on for Docker, which needs it.
        rm -f "$SYSCTL"
        before=$(cat "$ETC/ip_forward.before" 2>/dev/null || echo 1)
        rm -f "$ETC/ip_forward.before"
        [ -e /sys/class/net/docker0 ] && before=1
        sysctl -q -w net.ipv4.ip_forward="$before"
    fi
    nft delete table inet outpost-net 2>/dev/null || true   # name used by an early version
    nft_rules | nft -f -
    other_firewalls
    batman_gw_mode
    mesh_dns
    cmd_route
}

# With internet through the mesh, a node may have no other connection to
# get DNS servers from - give NetworkManager fixed ones (MESH_DNS).
NM_DNS=/etc/NetworkManager/conf.d/90-outpost-mesh-dns.conf
mesh_dns() {
    local want=
    if [ "$MESH_INTERNET" = auto ] && [ -n "$MESH_DNS" ] && [ -d /etc/NetworkManager/conf.d ]; then
        want=$(printf '%s\n' "# Outpost (outpost-net): DNS for internet through the mesh gateway." \
            "[global-dns-domain-*]" "servers=$(echo $MESH_DNS | tr ' ' ',')")
    fi
    if [ -n "$want" ]; then
        [ "$(cat "$NM_DNS" 2>/dev/null)" = "$want" ] && return 0
        printf '%s\n' "$want" > "$NM_DNS"
    elif [ -f "$NM_DNS" ]; then
        rm -f "$NM_DNS"
    else
        return 0
    fi
    systemctl reload NetworkManager 2>/dev/null || true
}

# ----------------------------------------------------- internet via the mesh

# The address of the gateway batman-adv picked. Every node's bat0 MAC is
# 02:ba:74:<suffix> and its address <prefix>.<suffix byte 2>.<byte 3>
# (outpost-mesh, halow-mesh), so: gateway originator -> the 02:ba:74 client
# it announces -> address.
mesh_gateway_addr() {
    local mac orig x y
    [ -n "$MESH_GATEWAY" ] && { echo "$MESH_GATEWAY"; return; }
    orig=$(batctl gwl -H 2>/dev/null | grep -E '^\s*(\*|=>)' | grep -oiE '([0-9a-f]{2}:){5}[0-9a-f]{2}' | head -1)
    [ -n "$orig" ] || return 0
    mac=$(batctl tg -H 2>/dev/null | awk -v o="$orig" '
        { n = 0; for (i = 1; i <= NF; i++) if ($i ~ /^([0-9a-f][0-9a-f]:){5}[0-9a-f][0-9a-f]$/) m[++n] = $i
          if (n >= 2 && tolower(m[2]) == tolower(o) && tolower(m[1]) ~ /^02:ba:74:/) { print m[1]; exit } }')
    [ -n "$mac" ] || return 0
    x=$(printf %d "0x$(echo "$mac" | cut -d: -f5)")
    y=$(printf %d "0x$(echo "$mac" | cut -d: -f6)")
    [ "$y" -eq 0 ] && y=1
    [ "$y" -eq 255 ] && y=254
    echo "$(mesh_prefix).$x.$y"
}

# Keep a default route through the mesh gateway. Its high metric means any
# other internet connection this machine has is used first.
cmd_route() {
    local cur want
    [ "$(id -u)" = 0 ] || return 0
    batman_gw_mode   # again here: bat0 loses it when the mesh restarts
    cur=$(ip -4 route show default dev bat0 2>/dev/null | awk '/proto static metric 900/ {print $3; exit}')
    want=
    if [ "$MESH_INTERNET" = auto ] && [ -e /sys/class/net/bat0 ]; then
        want=$(mesh_gateway_addr)
    fi
    [ "$cur" = "$want" ] && return 0
    [ -n "$cur" ] && ip route del default via "$cur" dev bat0 metric 900 2>/dev/null || true
    if [ -n "$want" ]; then
        ip route replace default via "$want" dev bat0 proto static metric 900
        say "internet through mesh gateway $want"
    fi
}

# ----------------------------------------------------------------- changes

drop_gateway() {  # remove UPLINK's entry from GATEWAYS
    local g keep
    keep=; for g in $GATEWAYS; do [ "${g%%:*}" = "$1" ] || keep="$keep $g"; done
    GATEWAYS=${keep# }
}

cmd_gateway() {
    local s served up
    need_root
    up=${1:?usage: outpost-net gateway UPLINK IFACE...}; shift
    [ $# -gt 0 ] || die "which interfaces should use $up's internet? e.g.: outpost-net gateway $up bat0"
    valid_if "$up"
    in_mesh "$up" && die "$up is part of the mesh - use bat0"
    served=
    for s in "$@"; do
        valid_if "$s"; [ "$s" != "$up" ] || die "$up can't serve itself"
        in_mesh "$s" && { say "skipping $s: it's part of the mesh, which bat0 covers"; continue; }
        served="${served:+$served,}$s"
    done
    [ -e "/sys/class/net/$up" ] || say "note: $up doesn't exist right now - it's used when it appears"
    drop_gateway "$up"
    GATEWAYS="${GATEWAYS:+$GATEWAYS }$up:$served"
    in_list bat0 "$*" && [ "$MESH_INTERNET" = auto ] && MESH_INTERNET=off   # a gateway doesn't need one
    save; cmd_apply
    say "$up shares its internet with: $(echo "$served" | tr "," " ")"
}

cmd_gateway_off() {
    need_root
    drop_gateway "${1:?usage: outpost-net gateway-off UPLINK}"
    save; cmd_apply
    say "$1 is no longer a gateway"
}

in_mesh() {  # part of bat0 (the HaLow radio, mesh Wi-Fi/Ethernet)
    [ "$(basename "$(readlink "/sys/class/net/$1/master" 2>/dev/null)" 2>/dev/null)" = bat0 ]
}

pair() { printf '%s\n%s\n' "$1" "$2" | sort | paste -sd: -; }

cmd_forward() {
    local a b p x
    need_root
    a=${1:?usage: outpost-net forward IFACE1 IFACE2}; b=${2:?usage: outpost-net forward IFACE1 IFACE2}
    valid_if "$a"; valid_if "$b"; [ "$a" != "$b" ] || die "pick two different interfaces"
    for x in "$a" "$b"; do in_mesh "$x" && die "$x is part of the mesh - use bat0"; done
    p=$(pair "$a" "$b")
    in_list "$p" "$FORWARD" || FORWARD="${FORWARD:+$FORWARD }$p"
    save; cmd_apply
    say "forwarding between $a and $b (both ways, no NAT)"
    say "  devices on each side need a route to the other side through this machine"
}

cmd_unforward() {
    local f keep p
    need_root
    p=$(pair "${1:?usage: outpost-net unforward IFACE1 IFACE2}" "${2:?}")
    keep=; for f in $FORWARD; do [ "$f" = "$p" ] || keep="$keep $f"; done
    FORWARD=${keep# }
    save; cmd_apply
    say "no more forwarding between $1 and $2"
}

cmd_mesh_internet() {
    local a
    need_root
    case "${1:-}" in auto|off) MESH_INTERNET=$1 ;; *) die "usage: outpost-net mesh-internet auto|off" ;; esac
    save; cmd_apply
    if [ "$1" = auto ]; then
        a=$(mesh_gateway_addr); say "using the mesh's gateway: ${a:-none found yet (checked every 20 seconds)}"
    else
        say "not using a mesh gateway"
    fi
}

cmd_status() {
    local f g m r
    echo "Gateways (NAT):"
    [ -n "$GATEWAYS" ] || echo "  none"
    for g in $GATEWAYS; do echo "  ${g%%:*} shares its internet with: $(echo "${g#*:}" | tr ',' ' ')"; done
    echo "Forwarding (no NAT):"
    [ -n "$FORWARD" ] || echo "  none"
    for f in $FORWARD; do echo "  ${f%%:*} <-> ${f#*:}"; done
    echo "Internet through the mesh gateway: $MESH_INTERNET"
    if [ "$MESH_INTERNET" = auto ]; then
        r=$(ip -4 route show default dev bat0 2>/dev/null | awk '{print $3; exit}')
        echo "  current gateway: ${r:-none found}"
    fi
    echo "IP forwarding: $(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null | sed 's/1/on/; s/0/off/')"
    m=$(batctl gw_mode 2>/dev/null | cut -d' ' -f1); [ -z "$m" ] || echo "batman-adv gateway mode: $m"
}

# ----------------------------------------------------------------- overview

# Mesh address of the node behind a batman-adv originator MAC: originator ->
# the 02:ba:74 bat0 MAC it announces -> <prefix>.<byte 5>.<byte 6>.
orig_addr() {
    local mac x y
    mac=$(batctl tg -H 2>/dev/null | awk -v o="$1" '
        { n = 0; for (i = 1; i <= NF; i++) if ($i ~ /^([0-9a-f][0-9a-f]:){5}[0-9a-f][0-9a-f]$/) m[++n] = $i
          if (n >= 2 && tolower(m[2]) == tolower(o) && tolower(m[1]) ~ /^02:ba:74:/) { print m[1]; exit } }')
    [ -n "$mac" ] || { echo "?"; return; }
    x=$(printf %d "0x$(echo "$mac" | cut -d: -f5)"); y=$(printf %d "0x$(echo "$mac" | cut -d: -f6)")
    [ "$y" -eq 0 ] && y=1
    [ "$y" -eq 255 ] && y=254
    echo "$(mesh_prefix).$x.$y"
}

card_role() {  # what an interface is doing, in words
    local i c mode ssid n sig m
    i=$1
    m=$(basename "$(readlink "/sys/class/net/$i/master" 2>/dev/null)" 2>/dev/null || true)
    if [ "$m" = bat0 ]; then
        case "$(basename "$(readlink -f "/sys/class/net/$i/device/driver" 2>/dev/null)" 2>/dev/null)" in
            morse*) echo "mesh (HaLow)"; return ;;
        esac
        case "$(iw dev "$i" info 2>/dev/null | awk '/type/ {print $2, $3; exit}')" in
            "mesh point") echo "mesh (802.11s, encrypted)" ;;
            IBSS*) echo "mesh (ad-hoc, unencrypted)" ;;
            *) case "$(basename "$(readlink -f "/sys/class/net/$i/device/driver" 2>/dev/null)" 2>/dev/null)" in
                   morse*) echo "mesh (HaLow)" ;; *) echo "mesh (Ethernet)" ;; esac ;;
        esac
        return
    fi
    [ "$i" = bat0 ] && { echo "the mesh"; return; }
    if [ -e "/sys/class/net/$i/phy80211" ] && command -v nmcli >/dev/null; then
        c=$(nmcli -g GENERAL.CONNECTION device show "$i" 2>/dev/null || true)
        if [ -n "$c" ] && [ "$c" != "--" ]; then
            mode=$(nmcli -g 802-11-wireless.mode connection show "$c" 2>/dev/null || true)
            ssid=$(nmcli -g 802-11-wireless.ssid connection show "$c" 2>/dev/null || true)
            if [ "$mode" = ap ]; then
                n=$(iw dev "$i" station dump 2>/dev/null | grep -c '^Station' || true)
                echo "access point \"$ssid\", $n device(s) connected"
            else
                sig=$(iw dev "$i" link 2>/dev/null | awk '/signal/ {print $2; exit}')
                echo "joined \"$ssid\"${sig:+, signal $sig dBm}"
            fi
            return
        fi
        echo "Wi-Fi, not in use"; return
    fi
    if [ "$(cat "/sys/class/net/$i/carrier" 2>/dev/null)" = 1 ]; then echo "connected"; else echo "no cable / down"; fi
}

cmd_overview() {
    local a dns f g gw halow i n o out p r up via
    echo "=== Network cards"
    up=$(ip -4 route show default 2>/dev/null | awk '{print $5; exit}')
    for p in /sys/class/net/*; do
        i=${p##*/}
        [ -e "$p/type" ] || continue
        case "$i" in lo|docker*|veth*|br-*|virbr*|gre0|gretap0|erspan0|ip_vti0|ip6_vti0|sit0|ip6tnl0|ip6gre0|tunl0|p2p-dev-*) continue ;; esac
        a=$(ip -4 -o addr show dev "$i" 2>/dev/null | awk '{print $4; exit}')
        r=$(card_role "$i")
        [ "$i" = "$up" ] && r="$r - internet goes out here"
        printf '  %-9s %-19s %s\n' "$i" "${a:--}" "$r"
    done

    echo; echo "=== Mesh (batman-adv)"
    if [ -e /sys/class/net/bat0 ]; then
        echo "  this node: $(ip -4 -o addr show dev bat0 | awk '{print $4; exit}')"
        n=$(batctl n -H 2>/dev/null | grep -c . || true)
        echo "  neighbours (in direct radio range): $n"
        # Best routes ("*") whose next hop is the node itself = direct neighbours.
        batctl o -H 2>/dev/null | awk '/^ *\*/ {
            n = 0; for (i = 1; i <= NF; i++) if ($i ~ /^([0-9a-fA-F][0-9a-fA-F]:){5}[0-9a-fA-F][0-9a-fA-F]$/) m[++n] = $i
            tq = 0; if (match($0, /\( *[0-9]+\)/)) { tq = substr($0, RSTART + 1, RLENGTH - 2); gsub(/ /, "", tq) }
            ifc = ""; if (match($0, /\[ *[^]]*\]/)) { ifc = substr($0, RSTART + 1, RLENGTH - 2); gsub(/ /, "", ifc) }
            if (n >= 2 && tolower(m[1]) == tolower(m[2])) print m[1], tq, ifc }' | while read -r o tq ifc; do
            printf '    %-15s link quality %3s%%  via %s\n' "$(orig_addr "$o")" "$(( tq * 100 / 255 ))" "$ifc"
        done
        o=$(batctl o -H 2>/dev/null | awk '$1 == "*"' | wc -l | tr -d ' ')
        echo "  nodes reachable through the mesh: $o"
        gw=$(batctl gw_mode 2>/dev/null | head -1)
        echo "  gateway mode: ${gw:-off}"
        r=$(ip -4 route show default dev bat0 2>/dev/null | awk '{print $3; exit}')
        [ -n "$r" ] && echo "  internet through mesh gateway: $r"
    else
        echo "  not running (no bat0)"
    fi

    if systemctl list-unit-files halow-mesh.service >/dev/null 2>&1 && [ -f /etc/halow-mesh/halow.env ]; then
        echo; echo "=== HaLow"
        halow=$(systemctl is-active halow-mesh.service 2>/dev/null || true)
        echo "  halow-mesh: $halow"
        for p in /sys/class/net/*; do
            i=${p##*/}
            case "$(basename "$(readlink -f "$p/device/driver" 2>/dev/null)" 2>/dev/null)" in morse*) ;; *) continue ;; esac
            n=$(iw dev "$i" station dump 2>/dev/null | grep -c '^Station' || true)
            echo "  $i: channel $(sed -n 's/^CHANNEL=//p' /etc/halow-mesh/halow.env | tr -d "'\"") ($(sed -n 's/^COUNTRY=//p' /etc/halow-mesh/halow.env | tr -d "'\"")), $n mesh peer(s)"
        done
    fi

    echo; echo "=== Internet"
    via=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "dev") {print $(i + 1); exit}}')
    if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; then out="reachable"; else out="NOT reachable"; fi
    echo "  $out${via:+ (via $via)}"
    if getent hosts example.com >/dev/null 2>&1; then dns="working"; else dns="NOT working"; fi
    echo "  name lookups (DNS): $dns"

    echo; echo "=== Gateways and forwarding"
    for g in $GATEWAYS; do echo "  ${g%%:*} shares its internet with: $(echo "${g#*:}" | tr ',' ' ')"; done
    for f in $FORWARD; do echo "  forwarding: ${f%%:*} <-> ${f#*:}"; done
    [ -n "$GATEWAYS$FORWARD" ] || echo "  none"

    echo; echo "=== Outpost"
    if pgrep -f 'scripts/run_client.py' >/dev/null 2>&1; then echo "  running"; else echo "  NOT running"; fi
}

# ----------------------------------------------------------- HaLow settings

HALOW_ENV=/etc/halow-mesh/halow.env
MORSE_CONF=/etc/modprobe.d/morse.conf

ask() {  # ask PROMPT DEFAULT
    local a
    if use_whiptail; then whiptail --title "Outpost HaLow" --inputbox "$1" 10 78 "$2" 3>&1 1>&2 2>&3; return; fi
    printf '%s [%s]: ' "$1" "$2" >&2; read -r a || return 1; echo "${a:-$2}"
}

say_box() {
    if use_whiptail; then whiptail --title "Outpost HaLow" --msgbox "$1" 16 78; else printf '\n%b\n' "$1" >&2; fi
}

# Values go into halow.env, which halow-mesh reads as shell.
safe_text() { case "$1" in *[\'\"\\\$\`]*|"") return 1 ;; esac; [ "${#1}" -le "${2:-32}" ]; }

halow_get() { sed -n "s/^$1=//p" "$HALOW_ENV" | head -1 | sed "s/^'\(.*\)'$/\1/"; }

halow_set() {  # halow_set KEY VALUE
    local tmp
    tmp=$HALOW_ENV.new
    awk -v k="$1" -v v="$1='$2'" 'BEGIN { done = 0 }
        $0 ~ "^" k "=" { print v; done = 1; next } { print }
        END { if (!done) print v }' "$HALOW_ENV" > "$tmp"
    chmod 600 "$tmp"; mv "$tmp" "$HALOW_ENV"
}

width_of() {  # US operating class -> channel width
    case "$1" in 68) echo "1 MHz" ;; 69) echo "2 MHz" ;; 70) echo "4 MHz" ;; 71) echo "8 MHz" ;; *) echo "op class $1" ;; esac
}

cmd_halow() {
    local c ch changed country_changed n oc pw what w
    need_root
    [ -f "$HALOW_ENV" ] || die "no HaLow here ($HALOW_ENV is missing)"
    changed=; country_changed=
    while :; do
        what=$(menu "HaLow settings - every HaLow node needs the same ones" \
            channel "Channel: $(halow_get CHANNEL), $(width_of "$(halow_get OP_CLASS)") wide" \
            country "Country: $(halow_get COUNTRY)" \
            name "Mesh name: $(halow_get MESH_ID)" \
            password "Mesh password: set ($(halow_get MESH_PASSWORD | awk '{print length}') characters)" \
            "done" "Done") || what="done"
        case "$what" in
            channel)
                if [ "$(halow_get COUNTRY)" != US ]; then
                    say_box "The channel list here is for the US (902-928 MHz). For $(halow_get COUNTRY), enter the channel and operating class from your regulator's or Morse Micro's channel table."
                    ch=$(ask "Channel number" "$(halow_get CHANNEL)") || continue
                    oc=$(ask "Operating class for that channel" "$(halow_get OP_CLASS)") || continue
                    if echo "$ch$oc" | grep -Eq '^[0-9]+$'; then halow_set CHANNEL "$ch"; halow_set OP_CLASS "$oc"; changed=1
                    else say_box "Channel and operating class must be numbers."; fi
                    continue
                fi
                w=$(menu "Channel width. Wider is faster but reaches less far; 4 MHz is a good fit for voice." \
                    1 "1 MHz - longest range, slowest" 2 "2 MHz - long range" \
                    4 "4 MHz - balanced (recommended)" 8 "8 MHz - fastest, shortest range") || continue
                case "$w" in
                    1) oc=68; set -- $(seq 1 2 51) ;;
                    2) oc=69; set -- $(seq 2 4 50) ;;
                    4) oc=70; set -- 8 16 24 32 40 48 ;;
                    8) oc=71; set -- 12 28 44 ;;
                esac
                n=; for c in "$@"; do n="$n $c ch$c"; done
                # shellcheck disable=SC2086
                ch=$(menu "Channel ($w MHz wide). Nearby HaLow networks or other 900 MHz devices can interfere - try another if links are poor." $n) || continue
                halow_set CHANNEL "${ch#ch}"; halow_set OP_CLASS "$oc"; changed=1 ;;
            country)
                c=$(ask "Two-letter country code (US, AU, NZ, EU, GB, JP, KR, SG ...). Must match where the radio is used, and your HaLow HAT's frequency band." "$(halow_get COUNTRY)") || continue
                c=$(echo "$c" | tr '[:lower:]' '[:upper:]')
                if ! echo "$c" | grep -Eq '^[A-Z]{2}$'; then say_box "\"$c\" isn't a two-letter country code."; continue; fi
                [ "$c" = "$(halow_get COUNTRY)" ] && continue
                halow_set COUNTRY "$c"
                [ -f "$MORSE_CONF" ] && sed -i "s/country=[A-Z][A-Z]/country=$c/" "$MORSE_CONF"
                changed=1; country_changed=1
                [ "$c" = US ] || say_box "Country set to $c. The channel list in this menu is for the US: check that channel $(halow_get CHANNEL) / operating class $(halow_get OP_CLASS) is valid in $c, and change it under Channel if not." ;;
            name)
                n=$(ask "Mesh name (up to 32 characters)" "$(halow_get MESH_ID)") || continue
                if safe_text "$n" 32; then halow_set MESH_ID "$n"; changed=1
                else say_box "Use 1-32 characters, without quotes, backslashes, \$ or backticks."; fi ;;
            password)
                pw=$(menu "HaLow mesh password (SAE/WPA3)" new "Make up a new one" type "Type one") || continue
                if [ "$pw" = new ]; then pw=$(head -c 18 /dev/urandom | base64 | tr -d '/+=' | cut -c1-20)
                else pw=$(ask "Password, 8-63 characters" "") || continue; fi
                if [ "${#pw}" -ge 8 ] && safe_text "$pw" 63; then
                    halow_set MESH_PASSWORD "$pw"; changed=1
                    say_box "New HaLow mesh password:\n\n  $pw\n\nEvery HaLow node needs it. Copy $HALOW_ENV to each one (install-node.sh --env)."
                else
                    say_box "Use 8-63 characters, without quotes, backslashes, \$ or backticks."
                fi ;;
            *) break ;;
        esac
    done
    [ -n "$changed" ] || return 0
    if [ -n "$country_changed" ]; then
        echo "Country changed: reboot for the HaLow driver to use it (sudo reboot)."
    elif systemctl is-active --quiet halow-mesh.service; then
        echo "Restarting HaLow with the new settings (the mesh drops for a few seconds)..."
        systemctl restart halow-mesh.service && echo "HaLow restarted." || echo "HaLow didn't restart - see: journalctl -u halow-mesh" >&2
    fi
    echo "Remember: every HaLow node needs the same settings, or they lose contact."
}

# --------------------------------------------------------------------- menu

ifaces() {  # every interface worth offering, with a short description
    local a d i p
    for p in /sys/class/net/*; do
        i=${p##*/}
        [ -e "$p/type" ] || continue    # e.g. bonding_masters is a file, not an interface
        in_mesh "$i" && continue        # its traffic shows up on bat0
        # Skip loopback, container plumbing and the kernel's unused tunnel placeholders.
        case "$i" in lo|docker*|veth*|br-*|virbr*|gre0|gretap0|erspan0|ip_vti0|ip6_vti0|sit0|ip6tnl0|ip6gre0|tunl0) continue ;; esac
        a=$(ip -4 -o addr show dev "$i" 2>/dev/null | awk '{print $4; exit}')
        d=
        [ "$i" = bat0 ] && d="the mesh"
        [ -e "$p/phy80211" ] && d="Wi-Fi"
        [ -e "$p/wireguard" ] || [ "$(cat "$p/type" 2>/dev/null)" = 65534 ] && d="tunnel"
        [ -z "$d" ] && [ -e "$p/device" ] && d="Ethernet"
        ip -4 route show default dev "$i" 2>/dev/null | grep -q . && d="${d:+$d, }has internet"
        echo "$i|${d:-network}${a:+ ($a)}"
    done
}

use_whiptail() { command -v whiptail >/dev/null && [ -t 0 ] && [ "${TERM:-dumb}" != dumb ]; }
q() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }

menu() {  # menu PROMPT TAG LABEL... -> TAG
    local a ans n prompt saved
    prompt=$1; shift
    if use_whiptail; then whiptail --title "Outpost network" --menu "$prompt" 20 78 10 "$@" 3>&1 1>&2 2>&3; return; fi
    saved=; for a in "$@"; do saved="$saved $(q "$a")"; done
    while :; do
        eval "set -- $saved"; say ""; say "$prompt"; n=0
        while [ $# -gt 0 ]; do n=$((n + 1)); say "$(printf '  %d  %-12s %s' "$n" "$1" "$2")"; shift 2; done
        printf 'Number (Enter to cancel): ' >&2; read -r ans || return 1; [ -n "$ans" ] || return 1
        eval "set -- $saved"; n=0
        while [ $# -gt 0 ]; do n=$((n + 1)); [ "$ans" = "$n" ] && { echo "$1"; return 0; }; shift 2; done
        say "  no choice $ans"
    done
}

checklist() {  # checklist PROMPT TAG LABEL ON|OFF ... -> chosen TAGs
    local a ans b n prompt saved sel
    prompt=$1; shift
    if use_whiptail; then
        whiptail --title "Outpost network" --separate-output --checklist "$prompt" 20 78 10 "$@" 3>&1 1>&2 2>&3 | tr '\n' ' '
        return
    fi
    saved=; for a in "$@"; do saved="$saved $(q "$a")"; done
    sel=; eval "set -- $saved"
    while [ $# -gt 0 ]; do [ "$3" = ON ] && sel="$sel $1"; shift 3; done
    while :; do
        eval "set -- $saved"; say ""; say "$prompt"; n=0
        while [ $# -gt 0 ]; do
            n=$((n + 1)); b="[ ]"; in_list "$1" "$sel" && b="[x]"
            say "$(printf '  %d %s %-12s %s' "$n" "$b" "$1" "$2")"; shift 3
        done
        printf 'Number to tick/untick, Enter when done, q to cancel: ' >&2
        read -r ans || return 1
        case "$ans" in "") echo "$sel"; return 0 ;; q|Q) return 1 ;; esac
        eval "set -- $saved"; n=0
        while [ $# -gt 0 ]; do
            n=$((n + 1))
            if [ "$ans" = "$n" ]; then
                if in_list "$1" "$sel"; then sel=$(echo " $sel " | sed "s/ $1 / /"); else sel="$sel $1"; fi
            fi
            shift 3
        done
    done
}

iface_menu() {  # iface_menu PROMPT [EXCLUDE] -> IFACE
    local d ex i prompt tmp
    prompt=$1; ex=${2:-}; set --
    tmp=$(ifaces)
    while IFS='|' read -r i d; do [ -n "$i" ] && ! in_list "$i" "$ex" && set -- "$@" "$i" "$d"; done <<EOF
$tmp
EOF
    [ $# -gt 0 ] || { say "no interfaces to choose from"; return 1; }
    menu "$prompt" "$@"
}

cmd_menu() {
    local a b d f g i m on p r sel tmp up what
    need_root
    while :; do
        say ""; cmd_status >&2
        what=$(menu "What would you like to do?" \
            status "Status: cards, mesh, internet at a glance" \
            gateway "Share an interface's internet with others (gateway, NAT)" \
            forward "Forward between two interfaces (no NAT)" \
            mesh "Use the mesh's gateway for internet (now: $MESH_INTERNET)" \
            remove "Remove a gateway or forwarding" \
            wifi "Wi-Fi: join a network, or be an access point (outpost-wifi)" \
            meshif "Mesh interfaces: which cards the mesh uses (outpost-mesh)" \
            meshset "Wi-Fi mesh settings: channel, country, names, password (not HaLow)" \
            halow "HaLow settings: channel, width, country, password" \
            "done" "Done") || return 0
        case "$what" in
            status)
                if use_whiptail; then
                    cmd_overview > "/tmp/outpost-status.$$" 2>&1
                    whiptail --title "Outpost status" --scrolltext --textbox "/tmp/outpost-status.$$" 30 90 || true
                    rm -f "/tmp/outpost-status.$$"
                else
                    say ""; cmd_overview >&2; printf '\nPress Enter to go back: ' >&2; read -r _ || true
                fi ;;
            gateway)
                up=$(iface_menu "Which interface has the internet to share (the uplink)?") || continue
                set --; tmp=$(ifaces)
                while IFS='|' read -r i d; do
                    [ -n "$i" ] && [ "$i" != "$up" ] || continue
                    on=OFF; [ "$i" = bat0 ] && on=ON
                    for g in $GATEWAYS; do [ "${g%%:*}" = "$up" ] && in_list "$i" "$(echo "${g#*:}" | tr ',' ' ')" && on=ON; done
                    set -- "$@" "$i" "$d" "$on"
                done <<EOF
$tmp
EOF
                sel=$(checklist "Which interfaces should use $up's internet?" "$@") || continue
                # shellcheck disable=SC2086
                if [ -n "$(echo $sel)" ]; then cmd_gateway "$up" $sel; else cmd_gateway_off "$up"; fi ;;
            forward)
                a=$(iface_menu "Forward between which interface...") || continue
                b=$(iface_menu "...and which other one?" "$a") || continue
                cmd_forward "$a" "$b" ;;
            mesh)
                m=$(menu "Route internet through the best gateway in the mesh?" \
                    auto "Yes - when this machine has no other internet connection" off "No") || continue
                cmd_mesh_internet "$m" ;;
            remove)
                set --
                for g in $GATEWAYS; do set -- "$@" "g:${g%%:*}" "gateway: ${g%%:*} -> $(echo "${g#*:}" | tr ',' ' ')"; done
                for f in $FORWARD; do set -- "$@" "f:$f" "forwarding: ${f%%:*} <-> ${f#*:}"; done
                [ $# -gt 0 ] || { say "nothing to remove"; continue; }
                r=$(menu "Remove which?" "$@") || continue
                case "$r" in
                    g:*) cmd_gateway_off "${r#g:}" ;;
                    f:*) p=${r#f:}; cmd_unforward "${p%%:*}" "${p#*:}" ;;
                esac ;;
            wifi) other_tool outpost-wifi ;;
            meshif) other_tool outpost-mesh select ;;
            meshset) other_tool outpost-mesh settings ;;
            halow) if [ -f "$HALOW_ENV" ]; then cmd_halow; else say "no HaLow on this machine"; fi ;;
            *) return 0 ;;
        esac
    done
}

other_tool() {  # run another Outpost network tool, if it's installed
    local t
    t=$(command -v "$1" 2>/dev/null || true)
    if [ -z "$t" ]; then
        say "$1 isn't installed on this machine - install-node.sh adds it"
        [ "$1" = outpost-wifi ] && ! command -v nmcli >/dev/null && say "  (it needs NetworkManager, which this machine doesn't have)"
        return 0
    fi
    shift
    "$t" "$@" || true
}

case "${1:-}" in
    "") cmd_menu ;;
    status) cmd_status ;;
    overview) cmd_overview ;;
    halow) cmd_halow ;;
    gateway) shift; cmd_gateway "$@" ;;
    gateway-off) shift; cmd_gateway_off "$@" ;;
    forward) shift; cmd_forward "$@" ;;
    unforward) shift; cmd_unforward "$@" ;;
    mesh-internet) shift; cmd_mesh_internet "$@" ;;
    apply) cmd_apply ;;
    _route) cmd_route ;;
    -h|--help|help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" ;;
    *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" >&2; exit 2 ;;
esac
