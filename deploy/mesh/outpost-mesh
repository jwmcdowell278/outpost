#!/bin/sh
# batman-adv mesh (bat0) over ordinary Wi-Fi (802.11s mesh point, SAE) and/or
# Ethernet interfaces. On a HaLow Pi it adds these interfaces to the same
# bat0 as the HaLow radio, joining the two meshes into one network.
#
#   outpost-mesh select            pick the mesh interfaces from a menu
#   outpost-mesh use [--force] IFACE...   set them directly (none = mesh off)
#   outpost-mesh list              network interfaces and what they can do
#   outpost-mesh status            mesh state, peers, batman neighbours
#   outpost-mesh start|stop|restart        (run by outpost-mesh.service)
#
# Settings: /etc/outpost-mesh/mesh.env (shared by every node) and
#           /etc/outpost-mesh/node.env (this machine's interfaces)
set -eu

ETC=${OUTPOST_MESH_ETC:-/etc/outpost-mesh}   # override only for testing
RUN=/run/outpost-mesh
NM_CONF=/etc/NetworkManager/conf.d/outpost-mesh.conf
MESH_WIFI=; MESH_ETH=
[ -f "$ETC/mesh.env" ] && . "$ETC/mesh.env"
[ -f "$ETC/node.env" ] && . "$ETC/node.env"
MESH_WIFI=${MESH_WIFI:-}; MESH_ETH=${MESH_ETH:-}

log() { echo "outpost-mesh: $*"; }
die() { echo "outpost-mesh: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "run with sudo"; }

# ---------------------------------------------------------------- interfaces

# Physical network interfaces (virtual ones - bridges, Docker, VPNs, bat0 -
# have no device behind them).
nics() {
    for p in /sys/class/net/*; do
        n=${p##*/}
        [ -e "$p/device" ] && echo "$n"
    done
}

driver() { basename "$(readlink -f "/sys/class/net/$1/device/driver" 2>/dev/null)" 2>/dev/null || echo "?"; }

kind() {  # wifi | halow | ethernet | other
    if [ -e "/sys/class/net/$1/phy80211" ]; then
        case "$(driver "$1")" in morse*) echo halow ;; *) echo wifi ;; esac
    elif [ "$(cat "/sys/class/net/$1/type" 2>/dev/null)" = 1 ]; then
        echo ethernet
    else
        echo other
    fi
}

can_mesh() {  # Wi-Fi card supports 802.11s mesh point
    phy=$(cat "/sys/class/net/$1/phy80211/name" 2>/dev/null) || return 1
    iw phy "$phy" info 2>/dev/null | sed -n '/Supported interface modes/,/^\s*[A-Z].*:$/p' | grep -q "mesh point"
}

# Interfaces this machine is reached through: the default route, and every
# SSH session's local address. Putting one in the mesh would cut it off.
connected_ifaces() {
    ip -o route show default 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p'
    command -v ss >/dev/null || return 0
    for a in $(ss -Htn state established '( sport = :ssh )' 2>/dev/null | awk '{print $3}' | sed 's/:[0-9]*$//; s/^\[//; s/\]$//; s/^::ffff://'); do
        ip -o addr show 2>/dev/null | awk -v a="$a" '{split($4, p, "/"); if (p[1] == a) print $2}'
    done
}

unusable() {  # why an interface can't go in the mesh (nothing = it can)
    case "$(kind "$1")" in
        wifi) can_mesh "$1" || echo "its Wi-Fi card can't do 802.11s mesh - use another card" ;;
        ethernet) : ;;
        halow) echo "it's the HaLow radio - halow-mesh already puts it in the mesh" ;;
        *) echo "it isn't Wi-Fi or Ethernet" ;;
    esac
}

in_list() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }

addr_of() { ip -4 -o addr show dev "$1" 2>/dev/null | awk '{print $4; exit}'; }

describe() {  # one-line description of an interface for list/select
    i=$1; k=$(kind "$i"); conn=$2
    case "$k" in
        wifi) if can_mesh "$i"; then what="Wi-Fi, can mesh"; else what="Wi-Fi, CAN'T mesh"; fi ;;
        ethernet) what="Ethernet" ;;
        halow) what="HaLow" ;;
        *) what="other" ;;
    esac
    a=$(addr_of "$i"); [ -n "$a" ] || a="no address"
    in_list "$i" "$conn" && a="$a - you're connected through this"
    in_list "$i" "$(halow_ifaces)" && a="always in the mesh (halow-mesh)"
    printf '%-9s %-18s %-10s %s\n' "$i" "$what" "$(driver "$i")" "$a"
}

halow_ifaces() {
    [ -f /etc/halow-mesh/halow.env ] || return 0
    for i in $(nics); do [ "$(kind "$i")" = halow ] && echo "$i"; done
}

cmd_list() {
    conn=$(connected_ifaces | sort -u | tr '\n' ' ')
    printf '  %-9s %-18s %-10s %s\n' IFACE TYPE DRIVER ADDRESS
    for i in $(nics); do
        m=" "; in_list "$i" "$MESH_WIFI $MESH_ETH" && m="*"
        printf '%s ' "$m"; describe "$i" "$conn"
    done
    echo "(* = in the mesh)"
}

# ------------------------------------------------------- choosing interfaces

# Text menu: toggle by number, Enter to save.
pick_text() {
    conn=$1; sel=$2; all=$(nics)
    while :; do
        echo >&2
        echo "Which network interfaces should the mesh use?" >&2
        n=0
        for i in $all; do
            n=$((n + 1))
            if in_list "$i" "$(halow_ifaces)"; then
                printf '     %s' "$(describe "$i" "$conn")" >&2; echo >&2; continue
            fi
            box="[ ]"; in_list "$i" "$sel" && box="[x]"
            printf '  %d %s %s' "$n" "$box" "$(describe "$i" "$conn")" >&2; echo >&2
        done
        printf 'Number to tick/untick, Enter to save, q to cancel: ' >&2
        read -r ans || exit 1
        case "$ans" in
            "") echo "$sel"; return 0 ;;
            q|Q) return 1 ;;
        esac
        n=0; hit=
        for i in $all; do
            n=$((n + 1))
            [ "$ans" = "$n" ] || continue
            hit=1
            if in_list "$i" "$(halow_ifaces)"; then
                echo "  $i is run by halow-mesh" >&2
            elif in_list "$i" "$sel"; then
                sel=$(echo " $sel " | sed "s/ $i / /; s/^ *//; s/ *$//")
            elif why=$(unusable "$i") && [ -n "$why" ]; then
                echo "  can't use $i: $why" >&2
            else
                sel=$(echo "$sel $i" | sed 's/^ *//')
            fi
        done
        [ -n "$hit" ] || echo "  no interface $ans" >&2
    done
}

# whiptail checklist (Raspberry Pi OS, Debian, Ubuntu have it).
pick_whiptail() {
    conn=$1; sel=$2; set --
    for i in $(nics); do
        [ -z "$(unusable "$i")" ] || continue
        d=$(describe "$i" "$conn" | cut -c11- | sed 's/  */ /g')
        st=OFF; in_list "$i" "$sel" && st=ON
        set -- "$@" "$i" "$d" "$st"
    done
    [ $# -gt 0 ] || { echo "no network interfaces to choose from" >&2; return 1; }
    h="\nWi-Fi cards that can't mesh aren't listed (see: outpost-mesh list)."
    [ -n "$(halow_ifaces)" ] && h="$h\nThe HaLow radio is always in the mesh."
    out=$(whiptail --title "Outpost mesh" --separate-output --checklist \
        "Which network interfaces should the batman-adv mesh use?\nSpace ticks/unticks, Enter saves.$h" \
        20 78 10 "$@" 3>&1 1>&2 2>&3) || return 1
    echo "$out" | tr '\n' ' ' | sed 's/ *$//'
}

cmd_select() {
    need_root
    [ -f "$ETC/mesh.env" ] || die "not set up yet - install it with install-node.sh"
    conn=$(connected_ifaces | sort -u | tr '\n' ' ')
    cur="$MESH_WIFI $MESH_ETH"; cur=$(echo "$cur" | sed 's/^ *//; s/ *$//')
    if command -v whiptail >/dev/null && [ -t 0 ] && [ "${TERM:-dumb}" != dumb ]; then
        sel=$(pick_whiptail "$conn" "$cur") || { echo "no changes"; exit 0; }
    else
        sel=$(pick_text "$conn" "$cur") || { echo "no changes"; exit 0; }
    fi
    risky=
    for i in $sel; do in_list "$i" "$conn" && risky="$risky $i"; done
    force=
    if [ -n "$risky" ]; then
        echo "This machine is reached through$risky. Putting it in the mesh will cut that connection off."
        printf 'Type "yes" to do it anyway: '
        read -r a; [ "$a" = yes ] || { echo "no changes"; exit 0; }
        force=--force
    fi
    # shellcheck disable=SC2086
    cmd_use $force $sel
}

# Set the mesh interfaces and apply: NetworkManager hands, service restart.
cmd_use() {
    need_root
    [ -f "$ETC/mesh.env" ] || die "not set up yet - install it with install-node.sh"
    force=0; [ "${1:-}" = --force ] && { force=1; shift; }
    conn=$(connected_ifaces | sort -u | tr '\n' ' ')
    wifi=; eth=
    for i in "$@"; do
        [ -e "/sys/class/net/$i" ] || die "no interface $i (see: outpost-mesh list)"
        why=$(unusable "$i"); [ -z "$why" ] || die "can't use $i: $why"
        if in_list "$i" "$conn" && [ "$force" = 0 ]; then
            die "$i carries this machine's connection - using it would cut it off (--force to do it anyway)"
        fi
        if [ "$(kind "$i")" = wifi ]; then wifi="$wifi $i"; else eth="$eth $i"; fi
    done
    wifi=${wifi# }; eth=${eth# }
    old="$MESH_WIFI $MESH_ETH"

    # Take the old set down with the old settings, then switch.
    systemctl stop outpost-mesh.service 2>/dev/null || true
    printf 'MESH_WIFI="%s"\nMESH_ETH="%s"\n' "$wifi" "$eth" > "$ETC/node.env"
    MESH_WIFI=$wifi; MESH_ETH=$eth

    if [ -d /etc/NetworkManager ]; then
        list=interface-name:bat0
        for i in $wifi $eth; do list="$list;interface-name:$i"; done
        mkdir -p "$(dirname "$NM_CONF")"
        printf '# The mesh interfaces are run by outpost-mesh.service, not NetworkManager.\n[keyfile]\nunmanaged-devices=%s\n' \
            "$list" > "$NM_CONF"
        systemctl reload NetworkManager 2>/dev/null || true
        # Give interfaces that left the mesh back to NetworkManager.
        for i in $old; do
            in_list "$i" "$wifi $eth" || nmcli device set "$i" managed yes 2>/dev/null || true
        done
    fi

    if [ -z "$wifi$eth" ]; then
        systemctl disable outpost-mesh.service >/dev/null 2>&1 || true
        echo "Mesh off - no interfaces selected."
        return 0
    fi
    systemctl enable outpost-mesh.service >/dev/null 2>&1 || true
    if systemctl restart outpost-mesh.service; then
        echo "Mesh on: $wifi $eth"
        cmd_status | head -1
    else
        die "the mesh didn't start - see: journalctl -u outpost-mesh"
    fi
}

# ------------------------------------------------------------------ running

# Fixed per-machine suffix from /etc/machine-id - same on every boot,
# different on every node. halow-mesh uses the same one, so a machine gets
# the same bat0 MAC and address whichever of the two creates bat0.
node_suffix() {
    md5sum /etc/machine-id | cut -c1-6 | sed 's/../&:/g; s/:$//'
}

derive_address() {
    [ -n "${BAT_ADDRESS:-}" ] && { echo "$BAT_ADDRESS"; return; }
    s=$(node_suffix)
    x=$(printf %d "0x$(echo "$s" | cut -d: -f2)")
    y=$(printf %d "0x$(echo "$s" | cut -d: -f3)")
    [ "$y" -eq 0 ] && y=1
    [ "$y" -eq 255 ] && y=254
    echo "$BAT_PREFIX.$x.$y/16"
}

unmanage() {  # keep NetworkManager's hands off an interface
    if command -v nmcli >/dev/null; then nmcli device set "$1" managed no 2>/dev/null || true; fi
}

ensure_bat0() {
    modprobe batman-adv
    if [ ! -e /sys/class/net/bat0 ]; then
        batctl ra "$BATMAN_ALGO"
        ip link add bat0 type batadv
        ip link set bat0 address "02:ba:74:$(node_suffix)"   # stable, so peers' ARP stays valid
    fi
    ip link set bat0 up
    unmanage bat0
    ip -4 addr show dev bat0 | grep -q inet || ip addr add "$(derive_address)" dev bat0
}

wait_iface() {
    i=0
    while [ ! -e "/sys/class/net/$1" ]; do
        i=$((i + 1)); [ "$i" -gt 20 ] && { log "no interface $1"; return 1; }
        sleep 1
    done
}

join_bat0() {
    # batman-adv adds 32 bytes; raise the MTU if the driver allows it,
    # otherwise batman fragments (works, slightly more airtime).
    ip link set "$1" mtu 1532 2>/dev/null || log "$1 MTU stays $(cat "/sys/class/net/$1/mtu")"
    ip link set "$1" master bat0
}

stop_wpa() {
    pid=$RUN/wpa-$1.pid
    if [ -f "$pid" ]; then
        kill "$(cat "$pid")" 2>/dev/null || true
        rm -f "$pid"
        sleep 1
    fi
}

start_wifi() {
    i=$1
    wait_iface "$i" || return 1
    can_mesh "$i" || { log "$i can't do 802.11s mesh"; return 1; }
    unmanage "$i"
    for r in /sys/class/net/"$i"/phy80211/rfkill*/soft; do
        if [ -e "$r" ]; then echo 0 > "$r"; fi
    done
    mkdir -p "$RUN"
    umask 077
    cat > "$RUN/wpa-$i.conf" <<EOF
ctrl_interface=DIR=$RUN/ctrl
country=$COUNTRY
network={
    ssid="$MESH_ID"
    mode=5
    frequency=$FREQ
    key_mgmt=SAE
    sae_password="$MESH_PASSWORD"
    ieee80211w=2
}
EOF
    umask 022
    stop_wpa "$i"
    ip link set "$i" up
    wpa_supplicant -B -D nl80211 -i "$i" -c "$RUN/wpa-$i.conf" -P "$RUN/wpa-$i.pid" -f "$RUN/wpa-$i.log"
    n=0
    until iw dev "$i" info 2>/dev/null | grep -q "type mesh point"; do
        n=$((n + 1)); [ "$n" -gt 15 ] && { log "$i didn't start the mesh - see $RUN/wpa-$i.log"; return 1; }
        sleep 1
    done
    # batman-adv does the routing, not 802.11s.
    iw dev "$i" set mesh_param mesh_fwding 0 2>/dev/null || true
    join_bat0 "$i"
    log "$i: Wi-Fi mesh '$MESH_ID' on $FREQ MHz ($COUNTRY)"
}

start_eth() {
    wait_iface "$1" || return 1
    unmanage "$1"
    ip link set "$1" up
    join_bat0 "$1"
    log "$1: Ethernet in the mesh"
}

cmd_start() {
    [ -f "$ETC/mesh.env" ] || die "no $ETC/mesh.env"
    [ -n "$MESH_WIFI$MESH_ETH" ] || { log "no interfaces selected (sudo outpost-mesh select)"; exit 0; }
    ensure_bat0
    ok=0; failed=0
    for i in $MESH_WIFI; do if start_wifi "$i"; then ok=$((ok + 1)); else failed=$((failed + 1)); fi; done
    for i in $MESH_ETH;  do if start_eth "$i";  then ok=$((ok + 1)); else failed=$((failed + 1)); fi; done
    log "bat0 = $(ip -4 -br addr show bat0 | awk '{print $3}'), $ok interface(s) up, $failed failed"
    [ "$ok" -gt 0 ]
}

cmd_stop() {
    for i in $MESH_WIFI $MESH_ETH; do
        [ -e "/sys/class/net/$i" ] || continue
        ip link set "$i" nomaster 2>/dev/null || true
        if in_list "$i" "$MESH_WIFI"; then stop_wpa "$i"; ip link set "$i" down || true; fi
    done
    # Remove bat0 only if nothing else (e.g. halow-mesh) still uses it.
    if [ -e /sys/class/net/bat0 ] && [ -z "$(ls /sys/class/net/bat0/lower_* 2>/dev/null)" ]; then
        ip link del bat0
    fi
}

cmd_status() {
    ip -br addr show bat0 2>/dev/null || echo "bat0: down"
    echo "--- mesh interfaces";      batctl if 2>/dev/null || true
    for i in $MESH_WIFI; do
        echo "--- $i peers (802.11s)"; iw dev "$i" station dump 2>/dev/null | grep -E "^Station|signal:|tx bitrate" || true
    done
    echo "--- batman neighbours";    batctl n 2>/dev/null || true
    echo "--- batman originators";   batctl o 2>/dev/null || true
}

case "${1:-}" in
    select) cmd_select ;;
    use) shift; cmd_use "$@" ;;
    list) cmd_list ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_stop; cmd_start ;;
    status) cmd_status ;;
    *) sed -n '5,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
