# Wi-Fi/Ethernet mesh settings, read by /usr/local/sbin/outpost-mesh.
# Every node needs the same values here (copy this file between nodes).
# This machine's own interfaces are in node.env. After editing:
#   sudo systemctl restart outpost-mesh

# Regulatory country - must match where the radio is used.
COUNTRY=US

# Wi-Fi mesh frequency in MHz. 2.4 GHz: 2412 (channel 1), 2437 (6), 2462 (11).
# 5 GHz (shorter range, often less crowded): 5180 (36), 5745 (149).
# Avoid 5 GHz DFS channels (52-144): a mesh can't start on them.
FREQ=2437

# 802.11s mesh name and password (SAE/WPA3).
MESH_ID=outpost-wifi-mesh
MESH_PASSWORD=

# Ad-hoc (IBSS) cell, for Wi-Fi cards that can't do 802.11s (e.g. a
# Raspberry Pi's built-in Wi-Fi). Uses FREQ above. NOT ENCRYPTED. The fixed
# cell ID keeps all nodes in one cell.
ADHOC_ID=outpost-adhoc
ADHOC_BSSID=02:6f:75:74:70:01

# Must match the HaLow mesh (/etc/halow-mesh/halow.env) if the two are
# bridged: same routing algorithm and address range make them one network.
BATMAN_ALGO=BATMAN_IV
BAT_ADDRESS=
BAT_PREFIX=10.42
